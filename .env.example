# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Generate a secret with:  openssl rand -hex 32

# --- PostgreSQL ---
POSTGRES_USER=practiceforge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=practiceforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://practiceforge:change-me-local-only@localhost:5433/practiceforge

# --- Auth (JWT) ---
JWT_SECRET_KEY=change-me-generate-with-openssl
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis (used from Phase 4) ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
